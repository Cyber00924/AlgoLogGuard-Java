# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Algorand TestNet public algod endpoint. Use a provider API token if required.
ALGORAND_ALGOD_URL=https://testnet-api.algonode.cloud
ALGORAND_ALGOD_TOKEN=
ALGORAND_NETWORK=testnet

# Demo mode uses a clearly labelled placeholder account; it is NOT a real wallet.
ALGORAND_DEMO_MODE=true
# Leave blank in demo mode. No mnemonic/private key is required.
ALGORAND_MNEMONIC=
# Keep writes disabled in demo mode.
BLOCKCHAIN_WRITES_ENABLED=false
SERVER_PORT=8080
